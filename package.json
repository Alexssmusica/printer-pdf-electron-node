{
  "name": "printer-pdf-electron-node",
  "version": "1.5.1",
  "description": "node bindings for printer pdf node and electron",
  "main": "./lib/index.js",
  "scripts": {
    "install": "node-gyp rebuild",
    "prebuild:master": "prebuild-install || node-gyp rebuild",
    "clean:lib": "rimraf lib/ && rimraf tsconfig-build.tsbuildinfo",
    "build": "npm run clean:lib && tsc -p tsconfig-build.json && node-gyp build",
    "build-release": "npm run format && npm run build && node release.js && npm run publish:npm",
    "format": "prettier --write \"**/*.{js,ts,mts,json}\" --ignore-path .gitignore",
    "publish:npm": "node publish.js",
    "rebuild": "node-gyp rebuild",
    "release": "node release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Alexssmusica/printer-pdf-electron-node.git"
  },
  "keywords": [
    "pdf",
    "printer",
    "node",
    "electron"
  ],
  "author": {
    "name": "Alex Santos de Souza",
    "url": "https://github.com/Alexssmusica/printer-pdf-electron-node/#readme",
    "email": "alexssmusica@gmail.com"
  },
  "binary": {
    "module_name": "printer_pdf_electron_node",
    "module_path": "build/Release/",
    "host": "https://github.com/Alexssmusica/printer-pdf-electron-node/releases/download/",
    "remote_path": "v{version}"
  },
  "gypfile": false,
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Alexssmusica/printer-pdf-electron-node/issues"
  },
  "homepage": "https://github.com/Alexssmusica/printer-pdf-electron-node#readme",
  "dependencies": {
    "bindings": "1.5.0",
    "dotenv": "18.0.9",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tsconfig/node18": "^18.2.4",
    "@types/bindings": "^1.5.5",
    "@types/node": "22.12.0",
    "prebuild-install": "^7.1.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "semantic-release": "^25.0.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 18.20.6"
  },
  "files": [
    "binding.gyp",
    "index.js",
    "printerPDF.js",
    "index.d.ts",
    "src/**/**/*",
    "lib/**/**/*",
    "pdfium/**/**/*",
    "build/Release/*.node"
  ]
}
